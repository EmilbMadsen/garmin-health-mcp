# Optional overrides. The API key itself belongs in the keyring (`garmin-health-mcp setup`)
# or a secret file, never in this file.
# GARMIN_PERSONAL_API_KEY_FILE=/run/secrets/garmin_api_key
# GARMIN_HEALTH_MCP_STATE_DIR=~/.config/garmin-health-mcp
# GARMIN_HEALTH_MCP_TZ=Europe/Copenhagen

# Remote deployment (compose.yaml). Copy to .env on the server; never commit .env.
# GARMIN_HEALTH_MCP_PUBLIC_URL=https://garmin.example.com
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:<pinned release>
# TUNNEL_TOKEN=<from the Cloudflare Zero Trust dashboard>
# GARMIN_HEALTH_MCP_AUTH_MODE=oauth            # or static_bearer (see docs/security.md)
# GARMIN_HEALTH_MCP_ALLOWED_CIDRS=160.79.104.0/21
